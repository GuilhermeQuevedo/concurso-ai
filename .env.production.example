# Docker Compose production environment variables
# Copy this file to .env and fill in the values

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_password_here
MYSQL_DATABASE=concurso_ai

# Auth
JWT_SECRET=CHANGE_ME_at_least_32_characters_random_string_here

# CORS (your domain)
CORS_ORIGIN=https://yourdomain.com

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
