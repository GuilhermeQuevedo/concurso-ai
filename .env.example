# Database (MySQL)
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/concurso_ai"

# Server
NODE_ENV=development
PORT=3333

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Provider (gemini | ollama | mock | claude | openai)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=your-gemini-api-key
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth (Login & Calendar)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/calendar?google_auth=callback

# Email Transacional (Resend ou SMTP para recuperação de senha)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Engrama <nao-responda@engrama.app>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=seu-usuario
