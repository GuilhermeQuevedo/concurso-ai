# LGPD / Privacidade & DPO (Encarregado pelo Tratamento de Dados Pessoais - Art. 41 LGPD)
DPO_EMAIL=dpo@engrama.com.br
DPO_NAME="Comitê de Privacidade e Proteção de Dados"

# Database (MySQL)
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/concurso_ai"

# Server
NODE_ENV=development
PORT=3333

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Provider (gemini | ollama | mock | claude | openai)
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
# GEMINI_API_KEY=your-gemini-api-key
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Google OAuth (Login & Calendar)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/calendar?google_auth=callback

# Email Transacional (Resend ou SMTP para recuperação de senha)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Engrama <nao-responda@engrama.app>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=seu-usuario
# SMTP_PASS=sua-senha
# SMTP_SECURE=false

# Stripe Integration (Payments, Billing, Invoicing)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_SEMESTRAL=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
# Redis Cache & Rate Limiting (Opcional - se ausente, usa MemoryStore em memória)
# REDIS_URL=redis://127.0.0.1:6379

# Rate Limiting (Ajustes de capacidade por minuto)
# RATE_LIMIT_AUTH_MAX=15
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_PUBLIC_MAX=60
# RATE_LIMIT_HEAVY_MAX=5

# LGPD Data Protection (AES-256-GCM para dados em repouso - obrigatório)
# Gerar chave de 64 hex (32 bytes) via: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
