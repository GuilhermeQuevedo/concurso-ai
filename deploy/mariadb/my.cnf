# ==============================================================================
# MariaDB Tuning Hardened Configuration (Hostinger KVM 1 - 1 vCPU, 4GB RAM)
# Destino na VPS: /etc/mysql/mariadb.conf.d/60-engrama-perf.cnf
# ==============================================================================

[mysqld]
# 1. Conexões e Threads (Node.js pool = 12 conexões, sobra espaço para migrações e rotinas de backup)
max_connections = 50
max_connect_errors = 10000
wait_timeout = 600
interactive_timeout = 600
thread_cache_size = 8

# 2. Orçamento de Memória InnoDB (Alvo: ~1 GB RAM = 25% da VPS de 4 GB)
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 1
innodb_log_file_size = 128M
innodb_log_buffer_size = 16M

# 3. Alta Performance de Escrita vs Tolerância a Falhas
# innodb_flush_log_at_trx_commit = 2:
# Grava no cache de arquivo do SO a cada transação e descarrega para o disco a cada 1 segundo.
# Ganhos: 5x a 10x mais transações/segundo, sem risco de corrupção se o Node ou MariaDB cair.
# (Risco residual: perda de no máximo 1s de transações apenas se a máquina física sofrer desligamento abrupto de energia).
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT

# 4. Arquivos e Tabelas Abertas
table_open_cache = 400
table_definition_cache = 400
open_files_limit = 4096

# 5. Queries Lentas e Observabilidade
slow_query_log = 1
slow_query_log_file = /var/log/mysql/mariadb-slow.log
long_query_time = 0.5
log_queries_not_using_indexes = 0

# 6. Desativação do Query Cache legado (ineficiente e fonte de contenção em MySQL/MariaDB moderno)
query_cache_type = 0
query_cache_size = 0
